# Local .env — on Streamlit Cloud use App Secrets instead (see DEPLOY.md)
OPENAI_API=YOUR_KEY_HERE
# OPENAI_API_KEY=YOUR_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=openai/gpt-oss-20b

# NVIDIA NIM (OpenAI-compatible) example:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=openai/gpt-oss-20b  (meta/llama-3.1-70b-instruct was retired 2026-08-26)
# Do NOT use embedding models here (e.g. nvidia/llama-nemotron-embed-*) — they return 404 for chat.

